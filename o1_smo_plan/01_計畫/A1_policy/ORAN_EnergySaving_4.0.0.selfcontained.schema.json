{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.o-ran.org/jsonschemas/a1td/oran_energysaving_4.0.0",
  "description": "This module is for O-RAN standard Energy saving policy.\n  Copyright 2026 O-RAN ALLIANCE e.V.\n Licensed under the Standards Collaboration, Copyright License Version 1.0 (the \"License\");\n You may not use this file except in compliance with the License.\n You may obtain a copy of the License at https://www.o-ran.org/sccl",
  "type": "object",
  "properties": {
    "scope": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "cellId": {
              "$ref": "#/$defs/CellId"
            }
          },
          "additionalProperties": false,
          "required": [
            "cellId"
          ]
        },
        {
          "type": "object",
          "properties": {
            "cellIdList": {
              "$ref": "#/$defs/CellIdList"
            }
          },
          "additionalProperties": false,
          "required": [
            "cellIdList"
          ]
        },
        {
          "type": "object",
          "properties": {
            "taIList": {
              "$ref": "#/$defs/TaIList"
            }
          },
          "additionalProperties": false,
          "required": [
            "taIList"
          ]
        }
      ]
    },
    "esObjectives": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "targetPeeEnergy": {
              "type": "integer"
            }
          },
          "additionalProperties": false,
          "required": [
            "targetPeeEnergy"
          ]
        },
        {
          "type": "object",
          "properties": {
            "esPercentage": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            }
          },
          "additionalProperties": false,
          "required": [
            "esPercentage"
          ]
        }
      ]
    },
    "esResources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/EsResource"
      },
      "minItems": 1
    }
  },
  "additionalProperties": false,
  "anyOf": [
    {
      "required": [
        "scope",
        "esObjectives"
      ]
    },
    {
      "required": [
        "scope",
        "esResources"
      ]
    }
  ],
  "$defs": {
    "AvoidanceType": {
      "type": "string",
      "enum": [
        "AVOID",
        "FORBID"
      ]
    },
    "ExtPowerResource": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "energySupplyModes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true,
          "description": "List of energy supply modes for which the policy applies. Values are expected to align with 3GPP TS 28.310 (EnergySupplyMode)."
        },
        "energySourceTypes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true,
          "description": "List of operator-configured energy source types for which the policy applies. In 3GPP TS 28.310, energySourceType is an operator-configured string and is not restricted to a closed list."
        },
        "preferRenewable": {
          "type": "boolean",
          "default": false
        },
        "cefMax": {
          "type": "number",
          "minimum": 0
        }
      },
      "anyOf": [
        {
          "required": [
            "energySupplyModes"
          ]
        },
        {
          "required": [
            "energySourceTypes"
          ]
        },
        {
          "required": [
            "preferRenewable"
          ]
        },
        {
          "required": [
            "cefMax"
          ]
        }
      ]
    },
    "EsResource": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "operationalCells": {
              "$ref": "#/$defs/CellIdList"
            },
            "operationalPreference": {
              "$ref": "#/$defs/AvoidanceType"
            },
            "dlPrbUsage": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "ulPrbUsage": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "externalPower": {
              "$ref": "#/$defs/ExtPowerResource"
            }
          },
          "additionalProperties": false,
          "required": [
            "operationalCells",
            "operationalPreference"
          ]
        },
        {
          "type": "object",
          "properties": {
            "coverageCells": {
              "$ref": "#/$defs/CellIdList"
            },
            "coveragePreference": {
              "$ref": "#/$defs/AvoidanceType"
            },
            "dlPrbUsage": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "ulPrbUsage": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "externalPower": {
              "$ref": "#/$defs/ExtPowerResource"
            }
          },
          "additionalProperties": false,
          "required": [
            "coverageCells",
            "coveragePreference"
          ]
        },
        {
          "type": "object",
          "properties": {
            "operationalCells": {
              "$ref": "#/$defs/CellIdList"
            },
            "operationalPreference": {
              "$ref": "#/$defs/AvoidanceType"
            },
            "coverageCells": {
              "$ref": "#/$defs/CellIdList"
            },
            "coveragePreference": {
              "$ref": "#/$defs/AvoidanceType"
            },
            "dlPrbUsage": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "ulPrbUsage": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "externalPower": {
              "$ref": "#/$defs/ExtPowerResource"
            }
          },
          "additionalProperties": false,
          "required": [
            "operationalCells",
            "operationalPreference",
            "coverageCells",
            "coveragePreference"
          ]
        }
      ]
    },
    "PlmnId": {
      "type": "object",
      "properties": {
        "mcc": {
          "type": "string",
          "pattern": "^[0-9]{3}$"
        },
        "mnc": {
          "type": "string",
          "pattern": "^[0-9]{2,3}$"
        }
      },
      "additionalProperties": false,
      "required": [
        "mcc",
        "mnc"
      ]
    },
    "NcI": {
      "type": "integer",
      "minimum": 0,
      "maximum": 68719476735
    },
    "EcI": {
      "type": "integer",
      "minimum": 0,
      "maximum": 268435455
    },
    "CId": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "ncI": {
              "$ref": "#/$defs/NcI"
            }
          },
          "additionalProperties": false,
          "required": [
            "ncI"
          ]
        },
        {
          "type": "object",
          "properties": {
            "ecI": {
              "$ref": "#/$defs/EcI"
            }
          },
          "additionalProperties": false,
          "required": [
            "ecI"
          ]
        }
      ]
    },
    "CellId": {
      "type": "object",
      "properties": {
        "plmnId": {
          "$ref": "#/$defs/PlmnId"
        },
        "cId": {
          "$ref": "#/$defs/CId"
        }
      },
      "additionalProperties": false,
      "required": [
        "plmnId",
        "cId"
      ]
    },
    "CellIdList": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/CellId"
      },
      "minItems": 1
    },
    "TaI": {
      "type": "object",
      "properties": {
        "plmnId": {
          "$ref": "#/$defs/PlmnId"
        },
        "tac": {
          "type": "string",
          "pattern": "^[A-Fa-f0-9]{6}$"
        }
      },
      "additionalProperties": false,
      "required": [
        "plmnId",
        "tac"
      ]
    },
    "TaIList": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/TaI"
      },
      "minItems": 1
    }
  }
}