diff -ru a/src/ves/ves.c b/src/ves/ves.c
--- a/src/ves/ves.c	2026-10-13 18:38:08.727491694 +0800
+++ b/src/ves/ves.c	2026-10-13 18:38:08.749491087 +0800
@@ -320,6 +320,25 @@
         goto failed;
     }
 
+    /* DT patch 0015: commonEventHeader start/lastEpochMicrosec = the PM window, not the send instant.
+       The send can land ~1 s after the window end, so SMO queries by whole minute fell into the next second. */
+    {
+        char ps[32], pe[32];
+        unsigned long long now_us = (unsigned long long)get_microseconds_since_epoch();
+        sprintf(ps, "%llu", data->period_start_us > 0 ? (unsigned long long)data->period_start_us : now_us);
+        sprintf(pe, "%llu", data->period_end_us > 0 ? (unsigned long long)data->period_end_us : now_us);
+        content = str_replace_inplace(content, "@periodStartMicrosec@", ps);
+        if(content == 0) {
+            log_error("str_replace_inplace() failed");
+            goto failed;
+        }
+        content = str_replace_inplace(content, "@periodEndMicrosec@", pe);
+        if(content == 0) {
+            log_error("str_replace_inplace() failed");
+            goto failed;
+        }
+    }
+
     content = str_replace_inplace(content, "@fileExpiry@", fileExpiry);
     if(content == 0) {
         log_error("str_replace_inplace() failed");
