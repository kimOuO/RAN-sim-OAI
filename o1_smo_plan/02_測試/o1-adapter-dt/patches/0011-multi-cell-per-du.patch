+        if(ci < n) {
+            asprintf(&want, "ManagedElement=%s,GNBDUFunction=%d,NRCellDU=%s", alarms_config->info.node_id, alarms_config->info.gnb_du_id,
+                     (cell_local_ids && cell_local_ids[ci]) ? cell_local_ids[ci] : "0");
+        }
+        const char *have = alarm_load[ci].object_instance;
+        if((want == 0) != (have == 0) || (want && have && strcmp(want, have) != 0)) {
+            changed = 1;
+            free(alarm_load[ci].object_instance);
+            alarm_load[ci].object_instance = want;
+            alarm_load[ci].state = ALARM_STATE_CLEARED;
+            alarm_load[ci].timeout = 0;
+        }
+        else {
+            free(want);
+        }
+    }
+    alarm_load_count = n;
+    return changed;
+}
