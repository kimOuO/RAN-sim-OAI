+/* DT patch 0009 (2026-10-01): NRCellDU operationalState / cellState are config false -> operational datastore. */
+static int netconf_data_set_nrcelldu_oper(const oai_data_t *oai) {
+    int rc = 0;
+    char *xp = 0;
+    if(NRCELLDU_XPATH == 0 || oai == 0) {
+        return 0;
+    }
+    const char *vals[2] = {oai->nrcelldu.operationalState ? oai->nrcelldu.operationalState : "ENABLED",
+                           oai->nrcelldu.cellState ? oai->nrcelldu.cellState : "ACTIVE"};
+    const char *leaf[2] = {"operationalState", "cellState"};
+    for(int i = 0; i < 2; i++) {
+        if(asprintf(&xp, "%s/attributes/%s", NRCELLDU_XPATH, leaf[i]) < 0) {
+            log_error("asprintf failed");
+            return 1;
+        }
+        log("[oper] populating %s with %s.. ", xp, vals[i]);
+        rc = sr_set_item_str(netconf_session_operational, xp, vals[i], 0, 0);
+        free(xp);
+        xp = 0;
+        if(rc != SR_ERR_OK) {
+            log_error("sr_set_item_str (nrcelldu oper) failed");
+            return 1;
+        }
+    }
+    rc = sr_apply_changes(netconf_session_operational, 0);
+    if(rc != SR_ERR_OK) {
+        log_error("sr_apply_changes (nrcelldu oper) failed");
+        return 1;
+    }
+    return 0;
+}
