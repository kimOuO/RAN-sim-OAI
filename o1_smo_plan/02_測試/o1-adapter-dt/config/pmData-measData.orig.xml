<?xml version="1.0" encoding="UTF-8"?>
<measDataFile
    xmlns:md="http://www.3gpp.org/ftp/specs/archive/28_series/28.532#measData"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.3gpp.org/ftp/specs/archive/28_series/28.532#measData measData.xsd">

    <fileHeader fileFormatVersion="28.532 V16.5.0"
                   vendorName="@vendor@"
                   dnPrefix="@DC=openairinterface.org@">
        <fileSender senderName="sender" senderType="gNB"/>
        <md:measData beginTime="@start-time@"/>
    </fileHeader>

    <measData>
        <measEntity userLabel="test"
                       localDn="ManagedElement=@node-id@"
                       swVersion="1.0"/>
        <measInfo measInfoId="1">
            <job jobId="1"/>
			<granPeriod duration="PT@log-period@S" endTime="@end-time@"/>
            <repPeriod duration="PT@log-period@S"/>
@metricNames@
            <measValue measObjLdn="DuFunction=@du-id@,CellId=@cell-id@">
@metricValues@
                <suspect>false</suspect>
            </measValue>
        </measInfo>
    </measData>

    <fileFooter>
        <md:measData endTime="@end-time@"/>
    </fileFooter>
</measDataFile>