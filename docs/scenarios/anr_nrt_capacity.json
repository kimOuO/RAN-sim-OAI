  "_metadata": {
    "dataset": "anr",
    "case_no": 9,
    "title": "NRT 容量修剪",
    "answer_type": "修",
    "topology": "n60_c0 / n62_c0 / n61_c0(一線)+ n77_c0(待發現,0/200m)",
    "arm": "把各 cell 的 NRT 填到 used==limit(ANR_NRT_CAPACITY=8),其中含零活動的 x24_c0 與受保護的 x25_c0(noRemove)",
    "trigger": "偵測到 n77 該建關係,但 ADD 被容量擋掉",
    "signal": "nrtCapacity used==limit;changeEvents 出現 ADD_REJECTED / NRT_CAPACITY_REACHED",
    "xapp_action": "先 REMOVE 零活動關係(x24_c0)騰位,再 ADD n6x_c0→n77_c0",
    "expected_ack": "被擋:result=ADD_REJECTED, detail=NRT_CAPACITY_REACHED;剪:result=REMOVED;補:result=ADDED",
    "verify": "剪一補一後 used 仍等於 limit(8/8,不得 9/8);受保護的 x25_c0 未被碰;反向由 gnb-xn 建且同受容量約束",
    "note": "ADD 的 sourceCellId 必須是既有 cell,不能反過來拿待發現 cell 當來源",
    "spec": "docs/anr_validation/12題劇本規格.md"
  },
