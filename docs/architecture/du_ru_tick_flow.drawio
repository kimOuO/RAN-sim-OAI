 as="geometry"/></mxCell><mxCell id="e39" parent="1" edge="1" style="endArrow=block;html=1;strokeColor=#333333;fontSize=11;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;" value="SDU 到達與 PRB、SINR → slot_engine;上行 ACK → ul_buffer"><mxGeometry relative="1" as="geometry"><mxPoint x="510" y="2806" as="sourcePoint"/><mxPoint x="870" y="2806" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e40" parent="1" edge="1" style="endArrow=open;html=1;dashed=1;strokeColor=#333333;fontSize=11;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;" value="RLC 延遲、上行送出位元組與 PRB"><mxGeometry relative="1" as="geometry"><mxPoint x="870" y="2868" as="sourcePoint"/><mxPoint x="510" y="2868" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e41" parent="1" edge="1" style="endArrow=block;html=1;strokeColor=#333333;fontSize=11;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;" value="PM 累積:PRB、送出位元組、SINR、MCS、CQI、rank、延遲、HARQ 期望輪次"><mxGeometry relative="1" as="geometry"><mxPoint x="510" y="2930" as="sourcePoint"/><mxPoint x="870" y="2930" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e42" parent="1" edge="1" style="endArrow=block;html=1;strokeColor=#333333;fontSize=11;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;" value="[每 PM 視窗,預設 1 s] 取視窗平均與總和"><mxGeometry relative="1" as="geometry"><mxPoint x="510" y="2992" as="sourcePoint"/><mxPoint x="870" y="2992" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e43" parent="1" edge="1" style="endArrow=open;html=1;dashed=1;strokeColor=#333333;fontSize=11;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;" value="每 UE 與每 cell 的視窗統計"><mxGeometry relative="1" as="geometry"><mxPoint x="870" y="3054" as="sourcePoint"/><mxPoint x="510" y="3054" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e44" parent="1" edge="1" style="endArrow=block;html=1;strokeColor=#333333;fontSize=11;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;" value="量測報告內容:serving、RSRP、SINR、鄰區、&#xa;吞吐、延遲、MCS、CQI"><mxGeometry relative="1" as="geometry"><mxPoint x="510" y="3116" as="sourcePoint"/><mxPoint x="330" y="3116" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e45" parent="1" edge="1" style="endArrow=block;html=1;strokeColor=#333333;fontSize=11;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;" value="F1 measurement_report(每 UE)&#xa;cell_measurement_report(每 cell)"><mxGeometry relative="1" as="geometry"><mxPoint x="330" y="3190" as="sourcePoint"/><mxPoint x="130" y="3190" as="targetPoint"/></mxGeometry></mxCell><mxCell id="b46" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;fontSize=11;spacingLeft=4;" value="SFN / slot 前進,場景時鐘 +sim_dt → 下一拍"><mxGeometry x="490" y="3250" width="280" height="36" as="geometry"/></mxCell><mxCell id="b74" parent="1" vertex="1" style="text;html=1;align=left;fontSize=11;fontColor=#555555;whiteSpace=wrap;" value="註 1:本圖依 2026-09-26 程式碼繪製。per-run 模板設 DU_RU_INPROCESS=on,DL TTI 以背景執行緒送出,tick 不等 RU;RU 回應在背景寫回,約晚一拍生效。"><mxGeometry x="60" y="3374" width="2300" height="26" as="geometry"/></mxCell><mxCell id="b75" parent="1" vertex="1" style="text;html=1;align=left;fontSize=11;fontColor=#555555;whiteSpace=wrap;" value="註 2:cached 模式 SINR 由 DU(fapi_north/channel_cache_du)直讀通道快取計算;RSRP、鄰區、rank、PMI、beam、CQI、上行 SINR 仍來自 RU。live 模式全部來自 RU。"><mxGeometry x="60" y="3402" width="2300" height="26" as="geometry"/></mxCell><mxCell id="b76" parent="1" vertex="1" style="text;html=1;align=left;fontSize=11;fontColor=#555555;whiteSpace=wrap;" value="註 3:DU 每拍不送 UL_TTI.request,RU 的 ul_tti_pipeline 與 CRC indication 不在每拍流程內;上行 SINR 在 DL TTI 同一趟計算。"><mxGeometry x="60" y="3430" width="2300" height="26" as="geometry"/></mxCell><mxCell id="b77" parent="1" vertex="1" style="text;html=1;align=left;fontSize=11;fontColor=#555555;whiteSpace=wrap;" value="註 4:UE 位置由 UE 容器另行推給 RU antenna(update_ues),不在 DU tick 內。DU 的 phy_high 已於 2026-09-26 移除。"><mxGeometry x="60" y="3458" width="2300" height="26" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>