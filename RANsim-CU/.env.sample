# Django
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,cu

# Database (PostgreSQL)
DB_HOST=postgres
DB_PORT=5432
DB_NAME=cu_db
DB_USER=cu_user
DB_PASSWORD=cu_pass

# Downstream systems
HTTP_DU_HOST=du
HTTP_DU_PORT=8000
HTTP_DU_SCHEME=http

HTTP_PHYSICS_HOST=physics
HTTP_PHYSICS_PORT=8000

# Mock 5GC (for InitialUEMessage / NgSetup)
HTTP_AMF_HOST=amf
HTTP_AMF_PORT=8000

# Identity (CU advertises itself)
GNB_ID=57344
PLMN_ID=00101
SERVED_TAC=1

# A3 handover (TS 38.331 §6.3.2 ReportConfigNR.eventA3)
HO_A3_OFFSET_DB=3.0
HO_A3_HYSTERESIS_DB=1.0
HO_TTT_MS=160
HO_SUCC_SINR_THRESH=3.0

# CU-UP (E1) — when CU-CP and CU-UP run as separate containers leave HOST/PORT;
# for monolithic build it just calls in-process abstractions.
HTTP_CUUP_HOST=
HTTP_CUUP_PORT=

# Logging
LOG_LEVEL=INFO
