# RAN-sim Environment Variables Configuration
# Copy this file to .env and adjust values as needed

# =============================================================================
# BACKEND (Django/FastAPI)
# =============================================================================

# Django Configuration
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Backend Server Port
HTTP_PORT=8000

# Scene Configuration (paths inside container)
SCENE_CONFIG_PATH=/mnt/srcin/scene_config.json
MITSUBA_SCENE_PATH=/app/scenes/umi_3sector.xml
SCENE_ID=umi_3sector_v1

# Simulation Parameters
SIM_DEFAULT_FREQ_GHZ=3.5
SIM_MAX_DEPTH=5
SIM_MAX_UES_PER_TICK=50
SIM_NOISE_FIGURE_DB=7

# Backend Logging
LOG_LEVEL=INFO
LOG_DIR=/app/logs

# =============================================================================
# FRONTEND (Next.js) - Docker Build Args
# Pass these to Docker build with: --build-arg VAR=value
# =============================================================================

# Backend API URL (accessed by browser)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Omniverse Backend URL (for visualization)
NEXT_PUBLIC_OMNIVERSE_URL=http://localhost:8001

# VNC Viewer URL (Omniverse visualization)
NEXT_PUBLIC_VNC_URL=http://localhost:6080/vnc.html

# WebSocket URL (real-time signal updates)
NEXT_PUBLIC_WS_URL=ws://localhost:8001/api/v0.1/RAN/UE/live

# Frontend Port
FRONTEND_PORT=3002

# =============================================================================
# DOCKER COMPOSE OVERRIDES
# =============================================================================

# Services can override defaults using these variables in docker-compose.yml
