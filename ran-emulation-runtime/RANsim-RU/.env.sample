# Django
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,ru

# Database (PostgreSQL)
DB_HOST=postgres
DB_PORT=5432
DB_NAME=ru_db
DB_USER=ru
DB_PASSWORD=ru

# 跨模組 API target（backend_rule §8-2 命名）
HTTP_DU_HOST=du
HTTP_DU_PORT=8000
HTTP_PHYSICS_HOST=physics
HTTP_PHYSICS_PORT=8000

# RU 預設天線配置（被 update_antenna 覆蓋）
RU_DEFAULT_ANTENNA_ROWS=4
RU_DEFAULT_ANTENNA_COLS=2
RU_DEFAULT_POLARIZATION=cross
RU_DEFAULT_PATTERN=tr38901

# Numerology / 量測模型
RU_NUMEROLOGY=1
RU_NOISE_FLOOR_DBM=-95
RU_CHANNEL_CACHE_TTL_SEC=0.5

# Logger
LOG_LEVEL=INFO
LOG_DIR=/app/logs
