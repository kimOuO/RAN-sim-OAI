# Django
DJANGO_SECRET_KEY=ransim-du-dev-please-override
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,du

# Database (Postgres)
DB_HOST=postgres
DB_PORT=5432
DB_NAME=du_db
DB_USER=ransim
DB_PASSWORD=ransim

# CU / RU endpoints
HTTP_CU_HOST=cu
HTTP_CU_PORT=8000
HTTP_RU_HOST=ru
HTTP_RU_PORT=8000

# Simulation
SIM_TICK_MS=500
SIM_SCHEDULER=PF
SIM_BLER_CURVE_PATH=/app/main/apps/phy_high/data/bler_curve.csv
SIM_GNB_DU_ID=1
# PRB 數 = cell 物理容量,同時是 PRB% KPM 分母 + scheduler 資源池。
# 106 = OAI band78 40MHz numerology1(對齊 OAI 對照)。★勿改回 273(那是 100MHz)★
# — 273 會讓 PRB% 分母對不上 OAI(4.4% vs ~10.7%)。
SIM_DEFAULT_PRB_PER_CELL=106
MIMO_RANK_THRESHOLD=0.1
