# RAN-sim Frontend Environment Variables
# These are embedded at build time for Next.js

# Backend API URL (FastAPI)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Omniverse backend URL
NEXT_PUBLIC_OMNIVERSE_URL=http://localhost:8001

# VNC viewer URL (Omniverse Kit)
NEXT_PUBLIC_VNC_URL=http://localhost:6080/vnc.html

# WebSocket URL for real-time signal updates
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws/sim/live/
