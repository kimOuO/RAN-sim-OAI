# Django
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,*

# Sim CU (內部 docker network)
SIM_CU_URL=http://cu:8000

# Near-RT RIC e2term (NodePort SCTP)
RIC_E2TERM_HOST=10.3.0.71
RIC_E2TERM_PORT=32222

# E2 link control flag (0=skeleton-only / 1=open SCTP at startup)
E2_ADAPTER_LINK_ENABLED=0

# ASN.1 schema directory inside container
ASN1_SCHEMA_DIR=/app/asn1

# Logging
LOG_LEVEL=INFO
