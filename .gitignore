*.pyc
*.pyo
*.pyd
*.egg-info/
build/
.pytest_cache/
.tox/

# venv
.venv/
venv/
env/

# Django
db.sqlite3
db.sqlite3-journal
*.log
logs/*.log
logs/*.log.*
